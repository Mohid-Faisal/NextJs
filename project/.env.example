# Copy this file to .env.local and fill in real values.
# Never commit secrets. Comments in .env files must not contain live passwords.

# Required
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
JWT_SECRET="replace-with-at-least-32-random-characters"

# Recommended
CRON_SECRET=""
RESEND_API_KEY=""
CPANEL_UPLOAD_SECRET_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CONTACT_EMAIL=""

# Optional billing / OAuth
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional error reporting
SENTRY_DSN=""

# Ops scripts only (copy-prod-to-staging.ts)
# PROD_DIRECT_URL=""
# PROD_REF=""
# STAGING_REF=""
