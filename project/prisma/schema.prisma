generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id           Int                  @id @default(autoincrement())
  name         String
  email        String               @unique
  password     String
  role         String               @default("USER")
  platformRole String?
  status       String               @default("PENDING")
  isApproved   Boolean              @default(false)
  approvedAt   DateTime?
  approvedBy   Int?
  createdAt    DateTime             @default(now())
  lastLoginAt  DateTime?
  memberships  OrganizationMember[]
  sessions     AuthSession[]
  phone        String?
  address      String?
}

/// Server-side session registry — enables instant revocation ("log out all
/// devices"), device listing, and ban propagation without waiting for JWT
/// expiry. The JWT carries the session id (`sid`); getSession() requires a
/// live, non-revoked row to match.
model AuthSession {
  id             String    @id @default(cuid())
  userId         Int
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId Int?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  @@index([userId])
}

model Organization {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  status        String   @default("active")
  logoUrl       String?
  currency      String   @default("PKR")
  invoicePrefix String?
  website       String?
  createdAt     DateTime @default(now())
  members       OrganizationMember[]
  subscription  Subscription?
  paymentProofs PaymentProof[]
}

model OrganizationMember {
  id             Int          @id @default(autoincrement())
  organizationId Int
  userId         Int
  role           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Plan {
  id                   Int            @id @default(autoincrement())
  code                 String         @unique
  name                 String
  priceMonthlyUsd      Decimal   @db.Decimal(19, 4)
  maxUsers             Int
  maxShipmentsPerMonth Int
  features             Json
  subscriptions        Subscription[]
  paymentProofs        PaymentProof[]
}

model Subscription {
  id                   Int          @id @default(autoincrement())
  organizationId       Int          @unique
  planId               Int
  status               String
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                 Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
}

model Shipment {
  id                Int       @id @default(autoincrement())
  organizationId    Int
  trackingId        String?
  invoiceNumber     String?
  referenceNumber   String
  agency            String?
  office            String?
  senderName        String
  senderAddress     String
  recipientName     String
  recipientAddress  String
  destination       String
  deliveryTime      String?
  invoiceStatus     String?
  deliveryStatus    String?
  trackingStatus    String?
  trackingStatusHistory Json?
  shippingMode      String?
  packaging         String?
  vendor            String?
  serviceMode       String?
  amount            Int       @default(1)
  packageDescription String?
  weight            Float     @default(0)
  length            Float     @default(0)
  width             Float     @default(0)
  height            Float     @default(0)
  weightVol         Float     @default(0)
  fixedCharge       Decimal   @default(0) @db.Decimal(19, 4)
  decValue          Decimal   @default(0) @db.Decimal(19, 4)
  price             Decimal   @default(0) @db.Decimal(19, 4)
  discount          Decimal   @default(0) @db.Decimal(19, 4)
  fuelSurcharge     Decimal   @default(0) @db.Decimal(19, 4)
  insurance         Decimal   @default(0) @db.Decimal(19, 4)
  customs           Decimal   @default(0) @db.Decimal(19, 4)
  tax               Decimal   @default(0) @db.Decimal(19, 4)
  declaredValue     Decimal   @default(0) @db.Decimal(19, 4)
  reissue           Decimal   @default(0) @db.Decimal(19, 4)
  profitPercentage  Float     @default(0)
  cos               Decimal   @default(0) @db.Decimal(19, 4)
  totalCost         Decimal   @db.Decimal(19, 4)
  subtotal          Decimal   @default(0) @db.Decimal(19, 4)
  manualRate        Boolean   @default(false)
  totalPackages     Int       @default(0)
  totalWeight       Float     @default(0)
  totalWeightVol    Float     @default(0)
  shipmentDate      DateTime  @default(now())
  packages          Json?
  packageTotals     Json?
  calculatedValues  Json?
  createdAt         DateTime  @default(now())
  invoices          Invoice[]

  @@unique([organizationId, trackingId])
  // SECURITY: invoice numbers are unique per organization, not globally —
  // a global unique let tenants probe each other's invoice numbers via
  // duplicate-key errors and caused cross-tenant numbering collisions.
  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
}

model Customers {
  id              Int       @id @default(autoincrement())
  organizationId  Int
  CompanyName     String
  PersonName      String
  Email           String
  Phone           String
  DocumentType    String
  DocumentNumber  String
  DocumentExpiry  String?
  Country         String
  State           String
  City            String
  Zip             String
  Address         String
  ActiveStatus    String
  FilePath        String
  createdAt       DateTime  @default(now())
  currentBalance  Decimal   @default(0) @db.Decimal(19, 4)
  creditLimit     Decimal   @default(0) @db.Decimal(19, 4)
  invoices        Invoice[]
  transactions    CustomerTransaction[]
  creditNotes     CreditNote[]

  @@unique([organizationId, CompanyName])
  @@index([organizationId])
}

model Vendors {
  id             Int       @id @default(autoincrement())
  organizationId Int
  CompanyName    String
  PersonName     String
  Email          String
  Phone          String
  Country        String
  State          String
  City           String
  Zip            String
  Address        String
  createdAt      DateTime  @default(now())
  currentBalance Decimal   @default(0) @db.Decimal(19, 4)
  creditLimit    Decimal   @default(0) @db.Decimal(19, 4)
  invoices       Invoice[]
  transactions   VendorTransaction[]
  debitNotes     DebitNote[]

  @@unique([organizationId, CompanyName])
  @@index([organizationId])
}

model Recipients {
  id                  Int       @id @default(autoincrement())
  organizationId      Int
  CompanyName         String
  PersonName          String
  Email               String
  Phone               String
  Country             String
  State               String
  City                String
  Zip                 String
  Address             String
  isRemoteArea        Boolean   @default(false)
  remoteAreaCompanies Json?
  createdAt           DateTime  @default(now())

  @@unique([organizationId, CompanyName])
  @@index([organizationId])
}

model DeliveryTime {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String
  createdAt      DateTime @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Agency {
  id             Int      @id @default(autoincrement())
  organizationId Int
  code           String
  name           String
  createdAt      DateTime @default(now())

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Office {
  id             Int      @id @default(autoincrement())
  organizationId Int
  code           String
  name           String
  createdAt      DateTime @default(now())

  @@unique([organizationId, code])
  @@index([organizationId])
}

model DeliveryStatus {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String
  code           String?
  icon           String?
  color          String?
  order          Int?     @default(0)
  status         String?  @default("Active")
  createdAt      DateTime @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ShippingMode {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String
  createdAt      DateTime @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
}

model PackagingType {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String
  createdAt      DateTime @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ServiceMode {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String
  code           String?
  mode           String?
  currency       String?
  status         String?  @default("Active")
  createdAt      DateTime @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
}

model HsCode {
  id             Int      @id @default(autoincrement())
  organizationId Int
  code           String
  description    String
  category       String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Zone {
  id             Int     @id @default(autoincrement())
  organizationId Int
  code           String
  country        String
  zone           String
  service        String
  phoneCode      String?

  @@index([organizationId])
  @@index([organizationId, service])
}

model ZoneUpload {
  id             Int      @id @default(autoincrement())
  organizationId Int
  service        String
  uploadedAt     DateTime @default(now())

  @@unique([organizationId, service])
  @@index([organizationId])
}

model RemoteArea {
  id             Int      @id @default(autoincrement())
  organizationId Int
  company        String
  country        String
  iataCode       String
  low            String
  high           String
  city           String?
  filename       String?
  uploadedAt     DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, company])
}

model Rate {
  id             Int    @id @default(autoincrement())
  organizationId Int
  weight         Float
  vendor         String
  service        String
  zone           String
  price          Int
  docType        String

  @@index([organizationId])
  @@index([organizationId, vendor, service])
}

model filename {
  id             Int      @id @default(autoincrement())
  organizationId Int
  filename       String
  vendor         String
  service        String
  fileType       String
  uploadedAt     DateTime @default(now())

  @@unique([organizationId, vendor, service, fileType])
  @@index([organizationId])
}

model CustomerTransaction {
  id              Int       @id @default(autoincrement())
  organizationId  Int
  customerId      Int
  customer        Customers @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type            String
  amount          Decimal   @db.Decimal(19, 4)
  description     String
  reference       String?
  invoice         String?
  previousBalance Decimal   @db.Decimal(19, 4)
  newBalance      Decimal   @db.Decimal(19, 4)
  createdAt       DateTime  @default(now())

  @@index([customerId])
  @@index([createdAt])
  @@index([organizationId])
}

model VendorTransaction {
  id              Int     @id @default(autoincrement())
  organizationId  Int
  vendorId        Int
  vendor          Vendors @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  type            String
  amount          Decimal   @db.Decimal(19, 4)
  description     String
  reference       String?
  invoice         String?
  previousBalance Decimal   @db.Decimal(19, 4)
  newBalance      Decimal   @db.Decimal(19, 4)
  createdAt       DateTime @default(now())

  @@index([vendorId])
  @@index([createdAt])
  @@index([organizationId])
}

model vendorservice {
  id             Int    @id @default(autoincrement())
  organizationId Int
  vendor         String
  service        String

  @@unique([organizationId, vendor, service])
  @@index([organizationId])
}

/// Accounts module: Payments
enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  ADJUSTMENT
  EQUITY
}

enum PartyType {
  US
  CUSTOMER
  VENDOR
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
}

model Payment {
  id              Int             @id @default(autoincrement())
  organizationId  Int
  transactionType TransactionType
  category        String
  date            DateTime
  amount          Decimal         @db.Decimal(19, 4)
  fromPartyType   PartyType
  fromCustomerId  Int?
  fromCustomer    String
  toPartyType     PartyType
  toVendorId      Int?
  toVendor        String
  mode            PaymentMode?
  reference       String?
  invoice         String?
  description     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  allocations     PaymentAllocation[]

  @@index([organizationId])
  @@index([organizationId, invoice])
  @@unique([organizationId, reference])
}

/// How a single Payment was applied across invoices. One Payment row stays
/// the customer-facing record; these rows are the durable source of truth
/// for per-invoice paid amounts (replaces the legacy "ALLOCATIONS:..."
/// description-string encoding). Invoice status is derived from these rows
/// plus legacy payments that have no allocation rows.
model PaymentAllocation {
  id             Int      @id @default(autoincrement())
  organizationId Int
  paymentId      Int
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId      Int
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount         Decimal  @db.Decimal(19, 4)
  createdAt      DateTime @default(now())

  @@index([organizationId, invoiceId])
  @@index([paymentId])
}

model Invoice {
  id              Int       @id @default(autoincrement())
  organizationId  Int
  invoiceNumber   String
  invoiceDate     DateTime
  receiptNumber   String?
  trackingNumber  String?
  destination     String
  dayWeek         String?
  weight          Float
  profile         String
  fscCharges      Decimal   @default(0) @db.Decimal(19, 4)
  discount        Decimal   @default(0) @db.Decimal(19, 4)
  lineItems       Json
  customerId      Int?
  customer        Customers? @relation(fields: [customerId], references: [id])
  vendorId        Int?
  vendor          Vendors?   @relation(fields: [vendorId], references: [id])
  shipmentId      Int?
  shipment        Shipment?  @relation(fields: [shipmentId], references: [id])
  disclaimer      String?
  status          String    @default("Unpaid")
  totalAmount     Decimal   @db.Decimal(19, 4)
  currency        String    @default("USD")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  debitNotes      DebitNote[]
  creditNotes     CreditNote[]
  allocations     PaymentAllocation[]

  // SECURITY: unique per organization (see Shipment note above).
  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([vendorId])
  @@index([shipmentId])
}

model DebitNote {
  id              Int      @id @default(autoincrement())
  organizationId  Int?
  debitNoteNumber String   @unique
  billId          Int?
  bill            Invoice? @relation(fields: [billId], references: [id])
  vendorId        Int?
  vendor          Vendors? @relation(fields: [vendorId], references: [id])
  amount          Decimal  @db.Decimal(19, 4)
  date            DateTime
  description     String?
  currency        String   @default("USD")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

model CreditNote {
  id               Int       @id @default(autoincrement())
  organizationId   Int?
  creditNoteNumber String    @unique
  invoiceId        Int?
  invoice          Invoice?  @relation(fields: [invoiceId], references: [id])
  customerId       Int
  customer         Customers @relation(fields: [customerId], references: [id])
  amount           Decimal   @db.Decimal(19, 4)
  date             DateTime
  description      String?
  currency         String    @default("USD")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([organizationId])
}

model ChartOfAccount {
  id             Int                @id @default(autoincrement())
  organizationId Int
  code           String
  accountName    String
  category       String
  type           String
  debitRule      String
  creditRule     String
  description    String?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  journalLines   JournalEntryLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model JournalEntry {
  id             Int                @id @default(autoincrement())
  organizationId Int
  entryNumber    String
  date           DateTime
  description    String
  reference      String?
  totalDebit     Decimal            @db.Decimal(19, 4)
  totalCredit    Decimal            @db.Decimal(19, 4)
  isPosted       Boolean            @default(false)
  postedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  lines          JournalEntryLine[]

  @@unique([organizationId, entryNumber])
  @@index([organizationId])
}

model JournalEntryLine {
  id             Int            @id @default(autoincrement())
  organizationId Int?
  journalEntryId Int
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      Int
  // SECURITY/INTEGRITY: Restrict (not Cascade) — deleting a Chart of Account
  // must never silently erase historical General Ledger lines.
  account        ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debitAmount    Decimal        @default(0) @db.Decimal(19, 4)
  creditAmount   Decimal        @default(0) @db.Decimal(19, 4)
  description    String?
  reference      String?
  createdAt      DateTime       @default(now())

  @@index([organizationId])
  @@index([journalEntryId])
  @@index([accountId])
}

model FixedCharge {
  id             Int      @id @default(autoincrement())
  organizationId Int
  weight         Float
  fixedCharge    Decimal  @db.Decimal(19, 4)
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

model AppSetting {
  key   String @id
  value String
}

model PaymentProof {
  id             Int          @id @default(autoincrement())
  organizationId Int
  planId         Int
  amount         Decimal      @db.Decimal(19, 4)
  currency       String       @default("PKR")
  method         String       // BANK_TRANSFER | EASYPAISA | JAZZCASH | CASH
  referenceId    String       // Transaction/Reference ID
  receiptUrl     String?      // Screenshot/Receipt upload URL
  status         String       @default("pending") // pending | approved | rejected
  notes          String?      // Optional admin notes
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

/// Append-only audit trail for security-relevant actions. Rows are never
/// updated or deleted by application code.
model AuditLog {
  id             BigInt   @id @default(autoincrement())
  organizationId Int?
  actorUserId    Int?
  actorEmail     String?
  action         String   // e.g. "login.success", "user.deactivate", "payment.process"
  entityType     String?  // e.g. "User", "Invoice", "Shipment"
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

/// Atomic per-organization document counters (invoice numbers, JE numbers,
/// etc.). Incremented inside transactions to prevent duplicates under
/// concurrency — replaces MAX(id)+1 scans.
model OrgSequence {
  organizationId Int
  key            String
  nextNumber     Int      @default(1)

  @@id([organizationId, key])
}
